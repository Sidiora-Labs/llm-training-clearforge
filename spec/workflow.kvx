# Spec workflow for this repository. Edit freely; cg reads it as data.

[meta]
name            = "Spec Workflow"
active_feature  = "training-v1"
source_of_truth = "spec/ (kvx). Generated files are pointers — regenerate, never hand-edit."

[mode]
name = "parallel"

[principle]
task_driven   = "Work is driven by the active feature's task list, in wave order."
verified_done = "A task is done only when its verify_cmd and graph checks pass."

[loop]
step_1 = "cg brief — load repo state, active task, and prior decisions."
step_2 = "cg spec next — take the lowest-wave eligible task."
step_3 = "cg spec start <id> — claim it."
step_4 = "cg context <area> — pull the code you need in one call."
step_5 = "Implement, and cg remember anything worth keeping."
step_6 = "cg commit -m <msg> — snapshot, auto-tagged with the task."
step_7 = "cg spec done <id> — qualification runs; done means proven."

[memory]
recall   = "cg recall at session start."
remember = "Persist decisions and constraints as they occur."

[status_values]
task = ["pending", "in_progress", "implemented", "done"]

[hard_rules]
no_fakes      = "Never fake a test to make it pass."
no_false_done = "Never mark a task done that did not qualify."

[render]
markdown_mirror = true
mirror_to_kiro  = false
banner = "GENERATED by cg spec render from spec/ kvx — DO NOT EDIT."

[adapters]
claude = "CLAUDE.md"
agents = "AGENTS.md"

[hierarchy]
main = "main"
pr = "manual"
test_gate = "/home/ubuntu/.venvs/clearforge/bin/python -m pytest -q"
lint_gate = "/home/ubuntu/.venvs/clearforge/bin/python -m ruff check src tests"

[role.worker]
wall = "90m"

